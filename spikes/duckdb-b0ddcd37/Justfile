# meridian-rs round-3 DuckDB spike — reproducible measurement recipes.
# Every number in REPORT.md is regenerated by `just bench`.

bin := "./target/release/spike"
db  := "data/wiki.duckdb"

# build the release binary (bundled libduckdb)
setup:
    cargo build --release

# axis 1: cold full build (extract vs insert split)
build: setup
    {{bin}} build {{db}}

# axis 1: discard + full rebuild
rebuild:
    {{bin}} rebuild {{db}}

# axis 1: incremental append latency (p50/p99, appends/sec) over N appends
append n="10000":
    {{bin}} append-bench {{db}} {{n}}

# axis 2: db/WAL size progression (dedicated db)
size: setup
    bash scripts/size.sh

# axis 2/3: WAL growth while a writer is live (default checkpoint threshold)
wal: setup
    bash scripts/wal_probe.sh

# axis 3: kill -9 crash durability (reopen + verify transcript)
kill: setup
    bash scripts/kill_test.sh

# axis 3: mixed-mode attach + writer contention (Rust + CLI)
attach: setup
    bash scripts/attach_test.sh

# axis 4+5: prepare a hot-history query db, then perf + queryability
query runs="200": setup
    bash scripts/query.sh {{runs}}

# step 8: root-stamp lifecycle end-to-end
rootstamp: setup
    {{bin}} rootstamp-demo data/fixture data/rootstamp.duckdb

# full measurement sweep → logs/*.log (regenerates every REPORT.md number)
bench: setup
    @mkdir -p logs
    {{bin}} build {{db}}               | tee logs/build.log
    {{bin}} rebuild {{db}}             | tee logs/rebuild.log
    cp {{db}} data/append.duckdb && rm -f data/append.duckdb.wal
    {{bin}} append-bench data/append.duckdb 10000 | tee logs/append.log
    bash scripts/size.sh               | tee logs/size.log
    bash scripts/wal_probe.sh          | tee logs/wal.log
    bash scripts/kill_test.sh          | tee logs/kill.log
    bash scripts/attach_test.sh        | tee logs/attach.log
    {{bin}} rootstamp-demo data/fixture data/rootstamp.duckdb | tee logs/rootstamp.log
    bash scripts/query.sh 200          | tee logs/query.log
    @echo "== all measurements in logs/ =="
