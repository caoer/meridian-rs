# CI image for the Woodpecker runner (.woodpecker/ci.yaml).
#
# Bakes every per-lane setup step into the image so pipelines start at the
# verdict, not at apt/rustup/binstall:
#   - rustfmt + clippy        (was: `rustup component add` in 3 lanes)
#   - python3-yaml            (was: apt-get in the test lane; the frontmatter
#                              tests cross-validate the engine YAML against PyYAML)
#   - mold                    (linker for every compiling lane; RUSTFLAGS below)
#   - cargo-deny + sccache    (was: binstall download+install in the deny lane)
#
# Built and rebuilt BY HAND on workstation-nyc-2 (`just ci-image`):
#
#   docker build -f Dockerfile.ci -t meridian-ci:<date> .
#
# The tag lanes run that local tag there with pull: false. ci.yaml runs on the
# CI pool VMs, which pull it from the forge's container registry, so a recut is
# also pushed. git.0xdao.app's public endpoint refuses a layer this size (413),
# so push to Forgejo directly on its internal address (token with package write):
#
#   docker save meridian-ci:<date> -o img.tar
#   crane auth login 172.21.0.18:26000 -u caoer115 --password-stdin
#   crane push --insecure img.tar 172.21.0.18:26000/caoer115/meridian-ci:<date>
#
# Recut = build a NEW tag, push it, and bump &rust_image in .woodpecker/ci.yaml
# (tag@digest, the digest crane prints) and the tag lanes' image, so a
# pipeline can only ever run against the recipe it names. rust:1-bookworm
# keeps the toolchain on rolling stable, but the move happens at image
# rebuild time, not by floating pull mid-pipeline.
FROM rust:1-bookworm

RUN rustup component add rustfmt clippy

# mold needs a driver that accepts -fuse-ld=mold: bookworm's gcc 12 does.
# wget stays for the binstall bootstrap below.
RUN apt-get -qq update \
 && apt-get -qq install -y --no-install-recommends python3-yaml mold wget \
 && rm -rf /var/lib/apt/lists/*

# Prebuilt binaries, no compile. Installed to /usr/local/bin so the test
# lane's non-root ci user can exec them (cargo subcommands resolve via PATH).
RUN wget -q -O- "https://github.com/cargo-bins/cargo-binstall/releases/latest/download/cargo-binstall-$(uname -m)-unknown-linux-musl.tgz" \
      | tar -xz -C /usr/local/bin \
 && cargo binstall -y --install-path /usr/local/bin cargo-deny sccache
