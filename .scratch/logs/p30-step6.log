+ set -eu
found=0
for manifest in crates/*/Cargo.toml; do
  pkg=$(basename "$(dirname "$manifest")")
  grep -q '^perf-walltime = ' "$manifest" || continue
  # every [[test]] block whose required-features names perf-walltime
  targets=$(awk '
    /^\[\[test\]\]/      { name=""; next }
    /^name *= *"/        { gsub(/^name *= *"|"$/,""); name=$0 }
    /perf-walltime/ && /required-features/ && name { print name; name="" }
  ' "$manifest")
  for t in $targets; do
    echo "--- clippy $pkg --test $t"
    cargo clippy -q -p "$pkg" --features perf-walltime --test "$t" --locked -- -D warnings
    found=$((found + 1))
  done
done
# A wrong path returns zero targets silently; refuse that.
test "$found" -gt 0 || { echo "no perf-gated targets discovered — the discovery is broken, not the repo"; exit 1; }
echo "linted $found perf-gated targets"

--- clippy mrd --test status_walltime
--- clippy mrd --test status_multiroot_cpu
--- clippy mrd --test walk_multiroot_cpu
--- clippy mrd --test check_multiroot_cpu
--- clippy mrd --test links_multiroot_cpu
--- clippy mrd --test sql_multiroot_cpu
--- clippy mrd --test perf_daemon_teardown
--- clippy run --test exec_walltime
